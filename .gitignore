**/.profile/

# 采集产出（岗位清单 Excel / JSON）
out/
**/out/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 工具运行产物（浏览器自动化 / 本地配置 / MCP 日志）
