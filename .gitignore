# 浏览器登录态（含 cookie / token，绝不提交）
.profile/
**/.profile/

# 采集产出（岗位清单 Excel / JSON）
out/
**/out/

# 数据目录：登录态、采集结果、求职者画像全部落在这里。
# 默认 JOBHUNT_HOME 是当前工作目录，用 --job-data 之类的命名时会被这个规则挡住；
# 显式列出常见命名，避免 personal 数据被 git add -A 扫进提交。
job-data/
jobdata/
*profile.md
!references/greeting-guide.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 工具运行产物（浏览器自动化 / 本地配置 / MCP 日志）
.playwright-mcp/
.zcode/
.setting/

# 选择器注册表的本地备份（--apply 时自动生成，可从 learned 重建）
*.json.bak
